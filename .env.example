# Copy to .env.local for local development. Every variable is optional locally.
# On Vercel, set them in Project Settings -> Environment Variables (see docs/DEPLOYMENT.md).

# Database. Defaults to embedded PGlite in ./.data/pglite when unset.
# Forms: postgres://... (the Neon integration sets DATABASE_URL), pglite:./path, pglite:memory
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs sessions. Required in production; generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Canonical public URL. Defaults to the production domain on Vercel production, the deployment URL on previews,
# or http://localhost:3000.
# BETTER_AUTH_URL=http://localhost:3000

# Extra comma-separated origins allowed to sign in (a custom domain not yet set as BETTER_AUTH_URL).
# AGINT_TRUSTED_ORIGINS=
