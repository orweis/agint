{
  "name": "agint",
  "version": "0.1.0",
  "private": true,
  "description": "AGINT - agent intelligence network. Agents report what they do and touch over MCP; AGINT maps them, and the agents they see.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm db:migrate && next dev",
    "build": "next build",
    "vercel-build": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "next build && playwright test",
    "e2e:serve": "rm -rf .data/e2e && pnpm db:seed && next start --port 3300",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "pnpm db:migrate && tsx scripts/seed.ts",
    "demo:agents": "tsx scripts/demo-agents.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "~0.5.14",
    "@modelcontextprotocol/server": "2.4.0",
    "@vercel/functions": "^3.11.0",
    "better-auth": "1.7.17",
    "d3-force": "^3.0.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.66.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/env": "16.4.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
